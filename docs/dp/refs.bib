}

@inproceedings{liu2023,
  author    = {Yuhan Liu and Ananda Theertha Suresh and Wennan Zhu and Peter Kairouz and
               Marco Gruteser},
  title     = {Algorithms for bounding contribution for histogram estimation under user-level
               privacy},
  booktitle = {International Conference on Machine Learning (ICML)},
  year      = {2023},
  eprint    = {2206.03008},
  archivePrefix = {arXiv},
  annote    = {VERIFIED by reading the paper: Algorithm 4 uses the exponential mechanism to select
               the bound, with score = expected error and sensitivity 5C_m/2. rand-clip samples
               min(l1 norm, C) items so one parameter bounds every norm ("each ||h_i||_r <= C for
               r = 0,1,2,inf"), hence it DOES bound l0 -- but as a by-product of l1 item sampling,
               only for the unbounded-domain sparse-vector algorithm, and in a COUNT setting where
               l0 = l1 numerically.}
}

@article{click2024,
  author    = {Yingtai Xiao and Jian Du and Shikun Zhang and Wanrong Zhang and Qiang Yan and
               Danfeng Zhang and Daniel Kifer},
  title     = {Click Without Compromise: Online Advertising Measurement via Per User
               Differential Privacy},
  journal   = {arXiv preprint arXiv:2406.02463},
  year      = {2024},
  eprint    = {2406.02463},
  archivePrefix = {arXiv},
  annote    = {Authors VERIFIED via the arXiv API. Content VERIFIED by reading the paper: Sec
               4.4-4.5 use the EM quantile with the identical utility u(X,o) = -||{x <= o}| - p*k|,
               and freeze-with-SVT-refresh. BUT Theorem 4.2 gives Delta_2 =
               sqrt(sum_i r_i^2/sigma_i^2) summed over all n days with NO cap on how many days a
               user spans, and Definition 4.1 is "Bounded Per-day Contributions". So r_i is an
               l-infinity per-group bound, NOT l0. Same primitive, different parameter.}
}

