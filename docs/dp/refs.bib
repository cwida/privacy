% ------------------------------------------------------- the DP quantile primitive

@inproceedings{smith2011,
  author    = {Adam Smith},
  title     = {Privacy-preserving statistical estimation with optimal convergence rates},
  booktitle = {Proceedings of the 43rd Annual ACM Symposium on Theory of Computing (STOC)},
  pages     = {813--822},
  year      = {2011},
  doi       = {10.1145/1993636.1993743},
  annote    = {The PAPER ITSELF is still unverified -- ACM blocks automated access and the arXiv
               preprint 0809.4794 ("Efficient, Differentially Private Point Estimators") is a
               different, earlier work containing no quantile or exponential-mechanism material.
               What IS verified, by reading Gillenwater et al.'s PDF directly: they write "Smith
               (2011) introduced the basic IndExp algorithm for estimating one quantile, and it has
               since been incorporated into the SmartNoise and IBM differential privacy libraries",
               and their reference list resolves that to this STOC 2011 paper. So the attribution
               is second-hand but from a peer-reviewed source that builds directly on it. Cite as
               the origin of the approach; do NOT claim the exact rank-distance utility appears
               verbatim in Smith without checking the PDF by hand.}
}

@inproceedings{gillenwater2021,
