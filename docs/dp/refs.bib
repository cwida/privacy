}

@article{click2024,
  author    = {Anonymous},
  title     = {Click Without Compromise: Online Advertising Measurement via Per User
               Differential Privacy},
  journal   = {arXiv preprint},
  year      = {2024},
  eprint    = {2406.02463},
  archivePrefix = {arXiv},
  annote    = {VERIFIED: Sections 4.4--4.5 use the EM quantile with the identical utility function
               u(X,o) = -||{x <= o}| - p*k|, and freeze-with-SVT-refresh. BUT Theorem 4.2 sums
               r_i^2/sigma_i^2 over all n days with NO cap on how many days a user spans, and
               Definition 4.1 is "Bounded Per-day Contributions" -- so r_i is an l-inf per-group
               bound, NOT l0. Different parameter, same primitive}
}

