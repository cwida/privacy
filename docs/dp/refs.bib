% ---------------------------------------------------------------- the baseline

@article{wilson2020,
  author    = {Royce J. Wilson and Celia Yuxin Zhang and William Lam and
               Damien Desfontaines and Daniel Simmons-Marengo and Bryant Gipson},
  title     = {Differentially Private {SQL} with Bounded User Contribution},
  journal   = {Proceedings on Privacy Enhancing Technologies},
  volume    = {2020},
  number    = {2},
  pages     = {230--250},
  year      = {2020},
  eprint    = {1909.01917},
  archivePrefix = {arXiv},
  annote    = {VERIFIED by reading the paper: automatic bound inference exists (ApproxBounds,
               Sec 5.1.1) but infers the VALUE range, hence signatures ANON_SUM(col, L, U). C_u is
               "an engine-defined constant", and "we assume that contribution bounds are specified
               as literals in each query". No automatic selection of C_u anywhere, including
               future work.}
}

