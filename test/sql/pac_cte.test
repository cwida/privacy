# Private UNION branches share one sampling-entity relation. Compare scalar stochastic
# outputs at mi=0 to ordinary SQL evaluated on the selected sampled world.
statement ok
SET priv_check = false;

statement ok
SET pac_pushdown_topk = false;

statement ok
SET pac_sample_diversity_check = false;

statement ok
CREATE PU TABLE union_owner (id INTEGER, PRIVACY_KEY(id));

statement ok
CREATE TABLE union_left(owner_id INTEGER, grp INTEGER, val INTEGER, PRIVACY_LINK(owner_id) REFERENCES union_owner(id));

statement ok
CREATE TABLE union_right(owner_id INTEGER, grp INTEGER, val INTEGER, PRIVACY_LINK(owner_id) REFERENCES union_owner(id));

statement ok
INSERT INTO union_owner SELECT i FROM range(1,513)t(i);

statement ok
INSERT INTO union_left SELECT i,i%7,CASE WHEN i%11=0 THEN NULL ELSE i%17 END FROM range(1,513)t(i);

statement ok
INSERT INTO union_right SELECT i,i%7,CASE WHEN i%11=0 THEN NULL ELSE i%17 END FROM range(128,513)t(i);

# all: NULL rows, duplicates and ordinary output values retain SQL semantics.
statement ok
SET priv_rewrite = true;

statement ok
CREATE TABLE union_actual AS SELECT grp,COUNT(*) n,COUNT(val) nv,SUM(val) total FROM (SELECT grp,val FROM union_left UNION ALL SELECT grp,val FROM union_right)u GROUP BY grp;

statement ok
SET priv_rewrite = false;

statement ok
CREATE TABLE union_expected AS SELECT grp,2*COUNT(*) n,2*COUNT(val) nv,2*SUM(val) total FROM (SELECT grp,val FROM union_left WHERE (priv_hash(hash(owner_id)) & 1)<>0 UNION ALL SELECT grp,val FROM union_right WHERE (priv_hash(hash(owner_id)) & 1)<>0)u GROUP BY grp;

query I
SELECT COUNT(*) FROM ((SELECT * FROM union_actual EXCEPT SELECT * FROM union_expected) UNION ALL (SELECT * FROM union_expected EXCEPT SELECT * FROM union_actual));
----
0

statement ok
DROP TABLE union_actual;

statement ok
DROP TABLE union_expected;

# distinct: NULL rows, duplicates and ordinary output values retain SQL semantics.
