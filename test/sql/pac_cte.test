# A materialized UNION and a second forwarding CTE retain the hidden mask.
statement ok
SET priv_rewrite = true;

statement ok
CREATE TEMP TABLE union_cte_actual AS
WITH u AS MATERIALIZED (
    SELECT grp,val FROM union_left UNION SELECT grp,val FROM union_right
), forwarded AS MATERIALIZED (SELECT grp,val FROM u)
SELECT grp,COUNT(*) n,SUM(val) total FROM forwarded GROUP BY grp;

statement ok
SET priv_rewrite = false;

statement ok
CREATE TEMP TABLE union_cte_expected AS
SELECT grp,2*COUNT(*) n,2*SUM(val) total FROM (
    SELECT grp,val FROM union_left WHERE (priv_hash(hash(owner_id)) & 1)<>0
    UNION SELECT grp,val FROM union_right WHERE (priv_hash(hash(owner_id)) & 1)<>0
)u GROUP BY grp;

query I
SELECT COUNT(*) FROM ((SELECT * FROM union_cte_actual EXCEPT SELECT * FROM union_cte_expected)
UNION ALL (SELECT * FROM union_cte_expected EXCEPT SELECT * FROM union_cte_actual));
----
0

statement ok
DROP TABLE union_cte_actual;

statement ok
DROP TABLE union_cte_expected;

# Branch-local DISTINCT/LIMIT must not silently discard world membership.
statement ok
SET priv_rewrite = true;

statement error
SELECT COUNT(*) FROM ((SELECT grp,val FROM union_left LIMIT 3) UNION ALL SELECT grp,val FROM union_right)u;
----
Private UNION requires raw branches without aggregation, DISTINCT or LIMIT

statement error
SELECT COUNT(*) FROM (SELECT DISTINCT grp,val FROM union_left UNION ALL SELECT grp,val FROM union_right)u;
----
Private UNION requires raw branches without aggregation, DISTINCT or LIMIT

# DISTINCT over a projected subset of UNION ALL values merges memberships.
statement ok
CREATE TEMP TABLE union_outer_distinct_actual AS
SELECT COUNT(*) n,SUM(grp) total FROM (
    SELECT DISTINCT grp FROM (
        SELECT grp FROM union_left UNION ALL SELECT grp FROM union_right
    )u
)d;

statement ok
SET priv_rewrite = false;

statement ok
CREATE TEMP TABLE union_outer_distinct_expected AS
SELECT 2*COUNT(*) n,2*SUM(grp) total FROM (
    SELECT DISTINCT grp FROM (
        SELECT grp FROM union_left WHERE (priv_hash(hash(owner_id)) & 1)<>0
        UNION ALL SELECT grp FROM union_right WHERE (priv_hash(hash(owner_id)) & 1)<>0
    )u
)d;

query I
SELECT COUNT(*) FROM union_outer_distinct_actual a FULL JOIN union_outer_distinct_expected e ON true
WHERE a.n IS DISTINCT FROM e.n OR a.total IS DISTINCT FROM e.total;
----
0

statement ok
DROP TABLE union_outer_distinct_actual;

statement ok
DROP TABLE union_outer_distinct_expected;

statement ok
SET priv_rewrite = true;

# The projected DISTINCT key can be NULL, and COUNT(*) still counts that row.
query II
SELECT COUNT(*),SUM(val) FROM (
    SELECT DISTINCT val FROM (
        SELECT grp,val FROM union_left UNION ALL SELECT grp,val FROM union_right
    )u
)d;
----
36	272

statement error
SELECT COUNT(*) FROM (
    SELECT DISTINCT ON(grp) grp,val FROM (
        SELECT grp,val FROM union_left UNION ALL SELECT grp,val FROM union_right
    )u ORDER BY grp,val
)d;
----
Private UNION does not support DISTINCT ON

