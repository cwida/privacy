# name: test/sql/pac_cte.test
# description: Test PAC bitslice compiler with Common Table Expressions (CTEs)
# group: [sql]

require privacy

statement ok
PRAGMA clear_privacy_metadata;

statement ok
SET privacy_seed = 42

statement ok
SET pac_hash_repair = true

statement ok
SET threads = 1

statement ok
SET pac_mi = 0

# Create TPC-H-like schema with proper PK-FK relationships

# Nation table
statement ok
CREATE TABLE nation(
    n_nationkey INTEGER,
    n_name VARCHAR,
    n_regionkey INTEGER
);

statement ok
INSERT INTO nation VALUES
    (0, 'FRANCE', 0),
    (1, 'GERMANY', 0),
    (2, 'JAPAN', 1),
    (3, 'CHINA', 1),
    (4, 'USA', 2);

statement ok
ALTER TABLE nation ADD PRIVACY_KEY (n_nationkey);

# Customer table (Privacy Unit)
statement ok
CREATE PU TABLE customer(
    c_custkey INTEGER,
    c_name VARCHAR,
    c_nationkey INTEGER,
    PRIVACY_KEY (c_custkey),
    PRIVACY_LINK (c_nationkey) REFERENCES nation(n_nationkey)
);

