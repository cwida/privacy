# name: test/sql/pac_sum.test
# description: Test as_sum aggregate function
# group: [sql]

require privacy

# Temporary native crash tracing; every statement still executes and is checked.
mode debug

statement ok
PRAGMA clear_privacy_metadata;

statement ok
PRAGMA enable_verification

# Set deterministic seed for cross-CPU reproducibility
statement ok
SET privacy_seed = 42

statement ok
SET pac_hash_repair = true

statement ok
SET threads = 1

statement ok
SET pac_mi = 0

# Create test data with 4000 rows
statement ok
CREATE TABLE test_data AS
SELECT i AS rowid, i % 3 AS grp, (i % 100) AS value
FROM range(4000) t(i)

# Ungrouped as_sum with INTEGER
query I
SELECT as_noised_sum(hash(rowid)::UBIGINT, value::INTEGER) IS NOT NULL FROM test_data
----
true

# Verify returns HUGEINT for signed integers
query I
SELECT typeof(as_noised_sum(hash(rowid)::UBIGINT, value::INTEGER)) FROM test_data
----
HUGEINT

# Test with non-zero mi parameter (deterministic results due to privacy_seed)
statement ok
SET pac_mi = 128

query I
SELECT as_noised_sum(hash(rowid)::UBIGINT, value::INTEGER) IS NOT NULL FROM test_data
----
true

statement ok
SET pac_mi = 0

# Test with explicit mi parameter (0.0 for no noise)
query I
SELECT as_noised_sum(hash(rowid)::UBIGINT, value::INTEGER) IS NOT NULL FROM test_data
----
true

# Grouped as_sum
query II
SELECT grp, as_noised_sum(hash(rowid)::UBIGINT, value::INTEGER) IS NOT NULL AS has_result
FROM test_data
GROUP BY grp
ORDER BY grp
----
0	true
1	true
2	true

# Test with different numeric types
query I
SELECT as_noised_sum(hash(rowid)::UBIGINT, value::BIGINT) IS NOT NULL FROM test_data
----
true

query I
SELECT as_noised_sum(hash(rowid)::UBIGINT, value::DOUBLE) IS NOT NULL FROM test_data
----
true

query I
SELECT as_noised_sum(hash(rowid)::UBIGINT, value::FLOAT) IS NOT NULL FROM test_data
----
true

query I
SELECT as_noised_sum(hash(rowid)::UBIGINT, value::SMALLINT) IS NOT NULL FROM test_data
----
true

query I
SELECT as_noised_sum(hash(rowid)::UBIGINT, (value % 127)::TINYINT) IS NOT NULL FROM test_data
----
true

# ===========================================================
# NULL handling tests - as_sum ignores NULLs (safe behavior, like DuckDB's SUM)
# ===========================================================

# Test ungrouped: NULL in value is ignored, result is NOT NULL
query I
SELECT as_noised_sum(hash(rowid)::UBIGINT, CASE WHEN rowid = 100 THEN NULL ELSE value END::INTEGER) IS NOT NULL FROM test_data
----
true

# Test ungrouped: NULL in key_hash is ignored, result is NOT NULL
query I
SELECT as_noised_sum(CASE WHEN rowid = 50 THEN NULL ELSE hash(rowid)::UBIGINT END, value::INTEGER) IS NOT NULL FROM test_data
----
true

# Test grouped: NULLs are ignored, all groups have non-NULL results
statement ok
CREATE TABLE test_null_groups AS
SELECT i AS rowid, i % 3 AS grp,
       CASE WHEN i = 0 THEN NULL ELSE (i % 100)::INTEGER END AS value
FROM range(30) t(i)

# All groups should have non-NULL results (NULLs are just ignored)
query II
SELECT grp, as_noised_sum(hash(rowid)::UBIGINT, value) IS NULL AS is_null
FROM test_null_groups
GROUP BY grp
ORDER BY grp
----
0	false
1	false
2	false

statement ok
DROP TABLE test_null_groups

# Test: all non-NULL values gives non-NULL result
query I
SELECT as_noised_sum(hash(rowid)::UBIGINT, value::INTEGER) IS NOT NULL FROM test_data
----
true

# ===========================================================
# Local/global summing tests - test flush threshold behavior
# ===========================================================

# For TINYINT, flush threshold is 8 (1 << 3)
# Create exactly 8 rows to test boundary
statement ok
CREATE TABLE test_tinyint_flush AS
SELECT i AS rowid, 10::TINYINT AS value FROM range(8) t(i)

query I
SELECT as_noised_sum(hash(rowid)::UBIGINT, value) IS NOT NULL FROM test_tinyint_flush
----
true

statement ok
DROP TABLE test_tinyint_flush

# For SMALLINT, flush threshold is 32 (1 << 5)
# Create data that exercises local->global summing
statement ok
CREATE TABLE test_smallint_flush AS
SELECT i AS rowid, (i % 100)::SMALLINT AS value FROM range(100) t(i)

query I
SELECT as_noised_sum(hash(rowid)::UBIGINT, value) IS NOT NULL FROM test_smallint_flush
----
true

statement ok
DROP TABLE test_smallint_flush

# For INTEGER, flush threshold is 256 (1 << 8)
# Create data larger than threshold to ensure multiple flushes
statement ok
CREATE TABLE test_integer_flush AS
SELECT i AS rowid, (i % 1000)::INTEGER AS value FROM range(1000) t(i)

query I
SELECT as_noised_sum(hash(rowid)::UBIGINT, value) IS NOT NULL FROM test_integer_flush
----
true

statement ok
DROP TABLE test_integer_flush

# For BIGINT, flush threshold is 65536 (1 << 16)
# Create data to exercise the accumulator (smaller dataset since threshold is huge)
statement ok
CREATE TABLE test_bigint_flush AS
SELECT i AS rowid, (i * 1000000)::BIGINT AS value FROM range(1000) t(i)

query I
SELECT as_noised_sum(hash(rowid)::UBIGINT, value) IS NOT NULL FROM test_bigint_flush
----
true

statement ok
DROP TABLE test_bigint_flush

# Test large values that trigger immediate flush (top B bits set)
# For TINYINT (8 bits), top 3 bits set means value >= 32 or <= -32
statement ok
CREATE TABLE test_large_tinyint AS
SELECT i AS rowid,
       CASE WHEN i % 2 = 0 THEN 100::TINYINT ELSE 5::TINYINT END AS value
FROM range(20) t(i)

query I
SELECT as_noised_sum(hash(rowid)::UBIGINT, value) IS NOT NULL FROM test_large_tinyint
----
true

statement ok
DROP TABLE test_large_tinyint

# Test with float - should accumulate correctly
statement ok
CREATE TABLE test_float_sum AS
SELECT i AS rowid, (i * 0.5)::FLOAT AS value FROM range(1000) t(i)

query I
SELECT as_noised_sum(hash(rowid)::UBIGINT, value) IS NOT NULL FROM test_float_sum
----
true

statement ok
DROP TABLE test_float_sum

# Test with double - should accumulate correctly
statement ok
CREATE TABLE test_double_sum AS
SELECT i AS rowid, (i * 0.123456789)::DOUBLE AS value FROM range(1000) t(i)

query I
SELECT as_noised_sum(hash(rowid)::UBIGINT, value) IS NOT NULL FROM test_double_sum
----
true

statement ok
DROP TABLE test_double_sum

# ===========================================================
# Grouped NULL tests - verify per-group NULL tracking
# ===========================================================

# Create table where group 1 has a NULL, groups 0 and 2 don't
# With safe NULL handling, NULLs are ignored, so all groups have results
statement ok
CREATE TABLE test_grouped_nulls AS
SELECT i AS rowid, i % 3 AS grp,
       CASE WHEN i = 1 THEN NULL ELSE (i % 50)::INTEGER END AS value
FROM range(300) t(i)

query II
SELECT grp, as_noised_sum(hash(rowid)::UBIGINT, value) IS NULL AS is_null
FROM test_grouped_nulls
GROUP BY grp
ORDER BY grp
----
0	false
1	false
2	false

statement ok
DROP TABLE test_grouped_nulls

# ============================================================================
# Sample diversity check tests
# ============================================================================

# Ungrouped: all rows hash to the same privacy unit → should trigger diversity error
statement error
SELECT as_noised_sum(hash(5)::UBIGINT, 1.0) FROM range(1000) t(i)
----
detected absence of sample diversity

statement ok
SET pac_sample_diversity_check = false

query I
SELECT as_noised_sum(hash(5)::UBIGINT, 1.0) IS NOT NULL FROM range(1000) t(i)
----
true

statement ok
SET pac_sample_diversity_check = true

# Grouped: each group has rows from the same privacy unit → should trigger diversity error
statement error
SELECT key, as_noised_sum(hash(5)::UBIGINT, 1.0) FROM (SELECT i % 3 AS key FROM range(3000) t(i)) sub GROUP BY key
----
detected absence of sample diversity

# Cleanup
statement ok
DROP TABLE test_data

# Signed packed counters must not carry into neighboring worlds. The full
# stream cancels, but worlds 1--63 contain only the positive rows, so overflow
# detection must bound input magnitudes rather than the signed full-stream sum.
statement ok
SET pac_sample_diversity_check = false

statement ok
CREATE TABLE signed_worlds AS
SELECT CASE WHEN i % 2 = 0 THEN 18446744073709551615::UBIGINT ELSE 1::UBIGINT END AS mask,
       CASE WHEN i % 2 = 0 THEN 1::BIGINT ELSE -1::BIGINT END AS v
FROM range(1000) t(i)

query II
WITH a AS (SELECT as_sum(mask, v) AS lanes FROM signed_worlds),
e AS (SELECT j, sum(v) FILTER (WHERE ((mask >> j) & 1) <> 0) AS s
      FROM signed_worlds CROSS JOIN range(64) worlds(j) GROUP BY j)
SELECT count(*), count(*) FILTER (WHERE lanes[j+1] / 2 = s::FLOAT) FROM e, a
----
64	64

# Finalization must retain contributions in all allocated levels. These values
# also sum without truncation in the approximate kernel (48 + 8192 = 8240).
query I
WITH t(v) AS (VALUES (1::BIGINT), (15::BIGINT), (32::BIGINT), (8192::BIGINT)),
a AS (SELECT as_sum(18446744073709551615::UBIGINT, v) AS lanes FROM t)
SELECT count(*) FILTER (WHERE lanes[j+1] / 2 = 8240::FLOAT)
FROM a CROSS JOIN range(64) worlds(j)
----
64

statement ok
DROP TABLE signed_worlds

statement ok
SET pac_sample_diversity_check = true

# Finalization must not force partially filled levels up to the top level: a
# world whose own total is small compared to the largest value in the group
# used to lose most of its precision (55890 finalized as 53248, -4.7%, when
# other worlds held values of several millions). World 0 holds only the small
# row; worlds 1..63 hold the three large rows.
query II
WITH t(mask, v) AS (VALUES (1::UBIGINT, 55890::BIGINT),
                           (18446744073709551614::UBIGINT, 3000000::BIGINT),
                           (18446744073709551614::UBIGINT, 5500000::BIGINT),
                           (18446744073709551614::UBIGINT, 9000000::BIGINT)),
a AS (SELECT as_sum(mask, v) AS lanes FROM t)
SELECT abs(lanes[1] / 2 - 55890) < 55890 * 0.001, abs(lanes[2] / 2 - 17500000) < 17500000 * 0.001 FROM a
----
true	true

# Cascading is lossless and finalization reads all levels, so the only error of
# a large sum is the per-value truncation at routing (at most 2^-8 per value,
# downward); the sum stays well within 0.1% of exact.
statement ok
CREATE TABLE approx_sum_large AS
SELECT 18446744073709551615::UBIGINT AS mask, (1048576 + (i * 1000003) % 7340032)::BIGINT AS v FROM range(100000) t(i)

query I
WITH a AS (SELECT as_sum(mask, v) AS lanes FROM approx_sum_large),
e AS (SELECT sum(v)::DOUBLE AS s FROM approx_sum_large)
SELECT abs(lanes[1] / 2 - s) / s < 0.001 FROM a, e
----
true

# Combine of two full levels: each UNION ALL branch is its own pipeline, so its
# partial state has exact_total[0] = 65535 at combine time. Since a cascade
# leaves up to 15 behind in each counter, the source level must be cascaded
# too, or 15 + 65535 would wrap the packed 16-bit lanes.
query I
WITH t AS (SELECT 18446744073709551615::UBIGINT AS mask, 1::BIGINT AS v FROM range(65535)
           UNION ALL SELECT 18446744073709551615::UBIGINT, 1::BIGINT FROM range(65535)
           UNION ALL SELECT 18446744073709551615::UBIGINT, 1::BIGINT FROM range(65535)),
a AS (SELECT as_sum(mask, v) AS lanes FROM t)
SELECT count(*) FILTER (WHERE lanes[j+1] / 2 = 196605) FROM a CROSS JOIN range(64) worlds(j)
----
64


# DuckDB 2.0 state export preserves buffers, positive/negative cascades, and
# pointer-backed counters. Values include a level above the inline-pointer area.
statement ok
SET priv_rewrite=false;

statement ok
SET threads=1;

statement ok
SET pac_mi=0;

statement ok
SET pac_sample_diversity_check=false;

statement ok
CREATE TABLE spill_sum_input AS
SELECT i%5 g,priv_hash(hash(i)) h,
       CASE WHEN i%3=0 THEN -(1::BIGINT<<48) ELSE 1024::BIGINT END v
FROM range(10000)t(i);

statement ok
CREATE TABLE spill_sum_states AS
SELECT g,as_sum(h,v) EXPORT_STATE s,
       as_sum(h,v::DOUBLE) EXPORT_STATE d,
       as_noised_sum(h,v::DECIMAL(18,2)) EXPORT_STATE dec,
       as_sum(h,abs(v)::UBIGINT,0.75) EXPORT_STATE u
FROM spill_sum_input GROUP BY g;

query I
SELECT count(*) FROM spill_sum_states a JOIN (
    SELECT g,as_sum(h,v) s,as_sum(h,v::DOUBLE) d,
           as_noised_sum(h,v::DECIMAL(18,2)) dec,
           as_sum(h,abs(v)::UBIGINT,0.75) u
    FROM spill_sum_input GROUP BY g
)b USING(g)
WHERE finalize(a.s) IS DISTINCT FROM b.s OR finalize(a.d) IS DISTINCT FROM b.d
   OR finalize(a.dec) IS DISTINCT FROM b.dec OR finalize(a.u) IS DISTINCT FROM b.u;
----
0

# One or two values stay buffered; NULL-only/empty groups have no inner state.
query I
SELECT finalize(s) IS NOT DISTINCT FROM expected FROM (
    SELECT as_sum(h,NULL::BIGINT) EXPORT_STATE s,as_sum(h,NULL::BIGINT) expected
    FROM spill_sum_input
);
----
true

query I
SELECT finalize(s) IS NOT DISTINCT FROM expected FROM (
    SELECT as_sum(h,v) EXPORT_STATE s,as_sum(h,v) expected
    FROM spill_sum_input WHERE false
);
----
true

query I
SELECT finalize(s) IS NOT DISTINCT FROM expected FROM (
    SELECT as_sum(h,v) EXPORT_STATE s,as_sum(h,v) expected
    FROM (SELECT h,v FROM spill_sum_input LIMIT 1)
);
----
true

query I
SELECT finalize(s) IS NOT DISTINCT FROM expected FROM (
    SELECT as_sum(h,v) EXPORT_STATE s,as_sum(h,v) expected
    FROM (SELECT h,v FROM spill_sum_input LIMIT 2)
);
----
true

# Compare the complete result under arena pressure with an in-memory execution.
# Mixed integer, floating-point, and DECIMAL states share the same hash table.
statement ok
SET memory_limit='256MB';

statement ok
CREATE TABLE spill_sum_expected AS
SELECT count(*) n,sum(hash(a,b,c)) checksum FROM (
    SELECT i//8 g,
           as_sum(18446744073709551615::UBIGINT,1::BIGINT) a,
           as_sum(18446744073709551615::UBIGINT,2::DOUBLE) b,
           as_noised_sum(18446744073709551615::UBIGINT,3::DECIMAL(18,2)) c
    FROM range(800000)t(i) GROUP BY g
);

statement ok
SET debug_force_external=true;

statement ok
SET memory_limit='32MB';

query II
SELECT actual.n,actual.checksum=expected.checksum FROM (
    SELECT count(*) n,sum(hash(a,b,c)) checksum FROM (
        SELECT i//8 g,
               as_sum(18446744073709551615::UBIGINT,1::BIGINT) a,
               as_sum(18446744073709551615::UBIGINT,2::DOUBLE) b,
               as_noised_sum(18446744073709551615::UBIGINT,3::DECIMAL(18,2)) c
        FROM range(800000)t(i) GROUP BY g
    )
)actual,spill_sum_expected expected;
----
100000	true

statement ok
SET debug_force_external=false;

statement ok
RESET memory_limit;


# Exported states remain combinable, including the high and negative levels.
query I
SELECT finalize(combine(a.s,b.s)) IS NOT DISTINCT FROM c.expected FROM
(SELECT as_sum(h,v) EXPORT_STATE s FROM spill_sum_input WHERE g<3)a,
(SELECT as_sum(h,v) EXPORT_STATE s FROM spill_sum_input WHERE g>=3)b,
(SELECT as_sum(h,v) expected FROM spill_sum_input)c;
----
true

statement error
SELECT finalize(to_aggregate_state(''::BLOB,'as_sum',['UBIGINT','BIGINT']));
----
Truncated stochastic aggregate state


# DECIMAL binding replaces its implementation; retain the logical third
# argument (sampling correction) when rebinding exported states.
query I
SELECT finalize(s) IS NOT DISTINCT FROM expected FROM (
    SELECT as_noised_sum(h,v::DECIMAL(18,2),0.75) EXPORT_STATE s,
           as_noised_sum(h,v::DECIMAL(18,2),0.75) expected
    FROM spill_sum_input
);
----
true


# Q78-shaped failure: sparse local groups stay buffered in the sink. Combining
# them must not manufacture a permanent full state for each final group.
statement ok
SET debug_force_external=true;

statement ok
SET memory_limit='32MB';

query II
SELECT count(*),count(*) FILTER (WHERE a=4 AND b=8 AND c=12) FROM (
    SELECT i%100000 g,
           as_noised_sum(18446744073709551615::UBIGINT,1::BIGINT) a,
           as_noised_sum(18446744073709551615::UBIGINT,2::DOUBLE) b,
           as_noised_sum(18446744073709551615::UBIGINT,3::DECIMAL(18,2)) c
    FROM range(200000)t(i) GROUP BY g
);
----
100000	100000

statement ok
SET debug_force_external=false;

statement ok
RESET memory_limit;

# The two-value buffer boundary: combine two buffered states, or a buffered
# destination and a materialized source. Every world must retain every value.
query I
SELECT count(*) FROM (
    SELECT finalize(combine(a.s,b.s)) lanes FROM
    (SELECT as_sum(18446744073709551615::UBIGINT,v) EXPORT_STATE s FROM (VALUES (13::BIGINT),(17))t(v))a,
    (SELECT as_sum(18446744073709551615::UBIGINT,29::BIGINT) EXPORT_STATE s)b
),unnest(lanes)t(v) WHERE v=118;
----
64

query I
SELECT count(*) FROM (
    SELECT finalize(combine(a.s,b.s)) lanes FROM
    (SELECT as_sum(18446744073709551615::UBIGINT,v) EXPORT_STATE s FROM (VALUES (1::BIGINT),(2))t(v))a,
    (SELECT as_sum(18446744073709551615::UBIGINT,v) EXPORT_STATE s FROM (VALUES (3::BIGINT),(4),(5))t(v))b
),unnest(lanes)t(v) WHERE v=30;
----
64

# All stochastic aggregates in a hash table must provide a state layout.
# Exercise COUNT's SWAR overflow, MIN/MAX, AVG decomposition and list-input states.
statement ok
SET priv_rewrite=false

statement ok
SET pac_mi=0

statement ok
SET pac_sample_diversity_check=false

statement ok
SET threads=1

statement ok
