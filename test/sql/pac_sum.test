statement ok
CREATE TABLE mixed_spill_expected AS
SELECT count(*) n,sum(hash(s,c,a,mn,mx)) checksum FROM (
 SELECT i//8 g,as_sum(18446744073709551615::UBIGINT,1::BIGINT) s,
 as_count(18446744073709551615::UBIGINT) c,
 as_noised_avg(18446744073709551615::UBIGINT,2::DOUBLE) a,
 as_min(18446744073709551615::UBIGINT,i%8) mn,
 as_max(18446744073709551615::UBIGINT,i%8) mx
 FROM range(800000)t(i) GROUP BY g
)

statement ok
SET memory_limit='32MB'

query I
SELECT r.n=e.n AND r.checksum=e.checksum FROM mixed_spill_expected e,(
 SELECT count(*) n,sum(hash(s,c,a,mn,mx)) checksum FROM (
 SELECT i//8 g,as_sum(18446744073709551615::UBIGINT,1::BIGINT) s,
 as_count(18446744073709551615::UBIGINT) c,
 as_noised_avg(18446744073709551615::UBIGINT,2::DOUBLE) a,
 as_min(18446744073709551615::UBIGINT,i%8) mn,
 as_max(18446744073709551615::UBIGINT,i%8) mx
 FROM range(800000)t(i) GROUP BY g
 ))r
----
true

statement ok
SET memory_limit='512MB'

statement ok
DROP TABLE mixed_spill_expected

# String states allocate variable byte counts in the shared import arena.
# Rebuilding the SUM state must realign its tagged inner-state pointer.
statement ok
SET memory_limit='32MB'

statement ok
SET debug_force_external=true

query II
SELECT count(*),count(*) FILTER (WHERE list_min(s)=6 AND list_max(s)=6 AND length(t)=39) FROM (
 SELECT i//3 g,string_agg(repeat('x',13),'') t,
 as_sum(18446744073709551615::UBIGINT,1::BIGINT) s
 FROM range(300000)t(i) GROUP BY g
)
----
100000	100000

statement ok
SET debug_force_external=false

statement ok
SET memory_limit='512MB'

query II
SELECT finalize(s)=expected,finalize(c)=expected FROM (
 SELECT as_noised_count(18446744073709551615::UBIGINT,0.75) EXPORT_STATE s,
 as_noised_count(18446744073709551615::UBIGINT,1::BIGINT,0.75) EXPORT_STATE c,
 as_noised_count(18446744073709551615::UBIGINT,0.75) expected FROM range(1000)
)
----
true	true

# NULL exported states occur naturally after an outer join. Native finalize
# propagates NULL, and combine keeps the non-NULL input unchanged.
query I
WITH s AS MATERIALIZED (
 SELECT as_sum(18446744073709551615::UBIGINT,1::BIGINT) EXPORT_STATE x,
 as_sum(18446744073709551615::UBIGINT,1::BIGINT) expected
)
SELECT finalize(CASE WHEN i=0 THEN x END) IS NOT DISTINCT FROM CASE WHEN i=0 THEN expected END
FROM s,range(2)t(i) ORDER BY i
----
true
true

query I
WITH s AS MATERIALIZED (
 SELECT as_sum(18446744073709551615::UBIGINT,1::BIGINT) EXPORT_STATE x,
 as_sum(18446744073709551615::UBIGINT,1::BIGINT) expected
)
SELECT finalize(combine(CASE WHEN i=0 THEN x END,CASE WHEN i=1 THEN x END)) IS NOT DISTINCT FROM expected
FROM s,range(2)t(i) ORDER BY i
----
true
true

statement ok
SET pac_sample_diversity_check=true

statement ok
SET memory_limit='80%'

statement ok
SET priv_rewrite=true
