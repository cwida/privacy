# name: test/sql/pac_categorical_subqueries.test
# description: Test PAC categorical queries - outer queries that compare against inner PAC aggregates
# group: [sql]

require privacy

statement ok
PRAGMA clear_privacy_metadata;

# Categorical queries are queries where:
# - An inner subquery contains a PAC aggregate (e.g., as_sum, as_count)
# - The outer query compares the aggregate result without its own aggregate
# - Example: WHERE value > (SELECT 0.5 * as_noised_sum(...) FROM ...)
#
# These require special handling:
# - Inner PAC aggregate returns all 64 counters (pac_*_counters variant)
# - Comparison becomes pac_gt/pac_lt/etc. returning a 64-bit mask
# - Final selection uses priv_filter() for probabilistic filtering

# ============================================================================
# Schema Setup - TPC-H style schema with customer as privacy unit
# ============================================================================

statement ok
CREATE PU TABLE customer (
    c_custkey INTEGER,
    c_name VARCHAR,
    c_nationkey INTEGER,
    c_acctbal DECIMAL(15,2),
    PRIVACY_KEY (c_custkey)
);

statement ok
CREATE TABLE nation (
    n_nationkey INTEGER,
    n_name VARCHAR
);

statement ok
ALTER TABLE nation ADD PRIVACY_KEY (n_nationkey);

statement ok
CREATE TABLE supplier (
    s_suppkey INTEGER,
    s_name VARCHAR,
    s_address VARCHAR,
    s_nationkey INTEGER
);

statement ok
ALTER TABLE supplier ADD PRIVACY_KEY (s_suppkey), ADD PRIVACY_LINK (s_nationkey) REFERENCES nation(n_nationkey);

statement ok
CREATE TABLE part (
    p_partkey INTEGER,
    p_name VARCHAR,
    p_type VARCHAR
);

statement ok
ALTER TABLE part ADD PRIVACY_KEY (p_partkey);

statement ok
CREATE TABLE partsupp (
    ps_partkey INTEGER,
    ps_suppkey INTEGER,
    ps_availqty INTEGER,
    ps_supplycost DECIMAL(15,2)
);

statement ok
ALTER TABLE partsupp ADD PRIVACY_KEY (ps_partkey, ps_suppkey), ADD PRIVACY_LINK (ps_partkey) REFERENCES part(p_partkey), ADD PRIVACY_LINK (ps_suppkey) REFERENCES supplier(s_suppkey);

statement ok
CREATE TABLE orders (
    o_orderkey INTEGER,
    o_custkey INTEGER,
    o_orderstatus VARCHAR,
    o_totalprice DECIMAL(15,2),
    o_orderdate DATE
);

statement ok
ALTER TABLE orders ADD PRIVACY_KEY (o_orderkey), ADD PRIVACY_LINK (o_custkey) REFERENCES customer(c_custkey);

statement ok
CREATE TABLE lineitem (
    l_orderkey INTEGER,
    l_partkey INTEGER,
    l_suppkey INTEGER,
    l_linenumber INTEGER,
    l_quantity DECIMAL(15,2),
    l_extendedprice DECIMAL(15,2),
    l_discount DECIMAL(15,2),
    l_shipdate DATE
);

statement ok
ALTER TABLE lineitem ADD PRIVACY_KEY (l_orderkey, l_linenumber), ADD PRIVACY_LINK (l_orderkey) REFERENCES orders(o_orderkey), ADD PRIVACY_LINK (l_partkey) REFERENCES part(p_partkey), ADD PRIVACY_LINK (l_suppkey) REFERENCES supplier(s_suppkey);

