# ============================================================================
# PAC Configuration
# ============================================================================

statement ok
SET privacy_seed = 42;

statement ok
SET pac_hash_repair = true

statement ok
SET threads = 1;

statement ok
SET pac_mi = 0;


# ============================================================================
# Test 1: Basic categorical query - Q20 style (greater than comparison)
# Find suppliers where partsupp availability exceeds threshold based on lineitem quantity
# ============================================================================

# This is a simplified Q20-style query:
# WHERE ps_availqty > (SELECT 0.5 * sum(l_quantity) FROM lineitem WHERE ...)
query II
SELECT
    s_name,
    s_address
FROM
    supplier
    JOIN nation ON s_nationkey = n_nationkey
WHERE
    s_suppkey IN (
        SELECT
            ps_suppkey
        FROM
            partsupp
        WHERE
            ps_partkey IN (
                SELECT p_partkey FROM part WHERE p_name LIKE 'forest%'
            )
            AND ps_availqty > (
                SELECT
                    0.5 * sum(l_quantity)
                FROM
                    lineitem
                    JOIN orders ON l_orderkey = o_orderkey
                WHERE
                    l_partkey = ps_partkey
                    AND l_suppkey = ps_suppkey
                    AND l_shipdate >= DATE '1994-01-01'
                    AND l_shipdate < DATE '1995-01-01'
            )
    )
    AND n_name = 'CANADA'
ORDER BY
    s_name;
----
Supplier#1	Address1
Supplier#2	Address2

# ============================================================================
# Test 2: Less than comparison in categorical query
# Find parts where average order quantity is less than a threshold
# ============================================================================

query II
SELECT
    p_partkey,
    p_name
FROM
    part
WHERE
    p_partkey IN (
        SELECT
            l_partkey
        FROM
            lineitem
            JOIN orders ON l_orderkey = o_orderkey
        WHERE
            l_quantity < (
                SELECT
                    avg(l2.l_quantity)
                FROM
                    lineitem l2
                    JOIN orders o2 ON l2.l_orderkey = o2.o_orderkey
                WHERE
                    l2.l_partkey = lineitem.l_partkey
            )
        GROUP BY l_partkey
    )
ORDER BY
    p_partkey;
----
1	forest green
2	forest blue
3	ocean red
4	forest yellow

# ============================================================================
# Test 3: Greater than or equal comparison
# Find suppliers with high-value lineitems
# The query involves HAVING with a scalar subquery containing PAC aggregates.
# ============================================================================

query I
SELECT
    s_suppkey
FROM
    supplier
WHERE
    s_suppkey IN (
        SELECT
            l_suppkey
        FROM
            lineitem
            JOIN orders ON l_orderkey = o_orderkey
        GROUP BY l_suppkey
        HAVING sum(l_extendedprice) >= (
            SELECT
                0.2 * sum(l2.l_extendedprice)
            FROM
                lineitem l2
                JOIN orders o2 ON l2.l_orderkey = o2.o_orderkey
        )
    )
ORDER BY
    s_suppkey;
----
1
2

# ============================================================================
# Test 4: Less than or equal comparison
# Find suppliers whose total lineitem value is at or below average
# (Replaced customer-based query which violated PAC rules - can't access privacy unit directly)
# NOTE: avg(total) of a PAC subquery result must use sum/count because native avg()
# cannot operate on counter-form (LIST) data produced by the categorical rewriter.
# ============================================================================
query I
SELECT count(*) FROM (
    SELECT
        s_suppkey
    FROM
        supplier
    WHERE
        (
            SELECT sum(l_extendedprice)
            FROM lineitem
            JOIN orders ON l_orderkey = o_orderkey
            WHERE l_suppkey = s_suppkey
        ) <= (
            SELECT sum(total) / count(total) FROM (
                SELECT sum(l_extendedprice) as total
                FROM lineitem
                JOIN orders ON l_orderkey = o_orderkey
                GROUP BY l_suppkey
            )
        )
);
----
2

# ============================================================================
# Test 5: Equal comparison (rare but should work)
# This is unlikely to match due to floating point, but tests the path
# ============================================================================

query I
SELECT count(*) FROM (
    SELECT
        ps_partkey
    FROM
        partsupp
    WHERE
        ps_availqty = (
            SELECT
                sum(l_quantity)::INTEGER
            FROM
                lineitem
                JOIN orders ON l_orderkey = o_orderkey
            WHERE
                l_partkey = ps_partkey
                AND l_suppkey = ps_suppkey
        )
);
----
0

# ============================================================================
# Test 6: Not equal comparison
# Find partsupps where availability differs from sum of quantities
# ============================================================================

query I
SELECT count(*) FROM (
    SELECT
        ps_partkey,
        ps_suppkey
    FROM
        partsupp
    WHERE
        ps_availqty <> (
            SELECT
                coalesce(sum(l_quantity), 0)::INTEGER
            FROM
                lineitem
                JOIN orders ON l_orderkey = o_orderkey
            WHERE
                l_partkey = ps_partkey
                AND l_suppkey = ps_suppkey
        )
);
----
6

# ============================================================================
# Test 7: Multiple categorical comparisons in same query
# Combines > and < comparisons
# ============================================================================

query II
SELECT
    p_partkey,
    p_name
FROM
    part
WHERE
    p_partkey IN (
        SELECT ps_partkey
        FROM partsupp
        WHERE
            ps_availqty > (
                SELECT 0.3 * sum(l_quantity)
                FROM lineitem
                JOIN orders ON l_orderkey = o_orderkey
                WHERE l_partkey = ps_partkey AND l_suppkey = ps_suppkey
            )
            AND ps_supplycost < (
                SELECT avg(l_extendedprice / l_quantity)
                FROM lineitem
                JOIN orders ON l_orderkey = o_orderkey
                WHERE l_partkey = ps_partkey
            )
    )
ORDER BY
    p_partkey;
----
1	forest green
2	forest blue
3	ocean red
4	forest yellow

# Note: Part 4 (forest yellow) is included because with corrected as_avg
# (2x compensation for 50% sampling), the avg(l_extendedprice/l_quantity)
# values are correct, and ps_supplycost=30 < avg ~= 43.33 evaluates to TRUE.

# ============================================================================
# Test 8: Nested subqueries with categorical comparison
# Similar to Q20 with nested IN clauses
# ============================================================================

query I
SELECT count(*) FROM (
    SELECT
        s_suppkey
    FROM
        supplier
    WHERE
        s_suppkey IN (
            SELECT ps_suppkey
            FROM partsupp
            WHERE
                ps_partkey IN (
                    SELECT p_partkey
                    FROM part
                    WHERE p_type = 'TYPE1'
                )
                AND ps_availqty > (
                    SELECT 0.5 * sum(l_quantity)
                    FROM lineitem
                    JOIN orders ON l_orderkey = o_orderkey
                    WHERE l_partkey = ps_partkey
                      AND l_suppkey = ps_suppkey
                )
        )
);
----
2

# ============================================================================
# Test 9: Categorical with arithmetic on aggregate result
# WHERE value > (SELECT factor * aggregate FROM ...)
# ============================================================================

query I
SELECT count(*) FROM (
    SELECT
        ps_partkey,
        ps_suppkey
    FROM
        partsupp
    WHERE
        ps_availqty * 0.5 > (
            SELECT
                0.25 * sum(l_quantity)
            FROM
                lineitem
                JOIN orders ON l_orderkey = o_orderkey
            WHERE
                l_partkey = ps_partkey
                AND l_suppkey = ps_suppkey
        )
);
----
6

# ============================================================================
# Test 10: Categorical with COUNT aggregate
# NOTE: avg(cnt) of a PAC subquery result must use sum/count because native avg()
# cannot operate on counter-form (LIST) data produced by the categorical rewriter.
# ============================================================================

query I
SELECT count(*) FROM (
    SELECT
        s_suppkey
    FROM
        supplier
    WHERE
        (
            SELECT count(*)
            FROM lineitem
            JOIN orders ON l_orderkey = o_orderkey
            WHERE l_suppkey = s_suppkey
        ) > (
            SELECT sum(cnt) / count(cnt) FROM (
                SELECT count(*) as cnt
                FROM lineitem
                JOIN orders ON l_orderkey = o_orderkey
                GROUP BY l_suppkey
            )
        )
);
----
1

# Independently evaluate all 64 sampled worlds with ordinary SQL. Only supplier
# 1 passes in at least half of the worlds. DuckDB 2.0's nullable-COUNT wrapper
# contains two COUNT states; both must remain world-specific through its CASE.
statement ok
SET priv_check = false;

statement ok
SET priv_rewrite = false;

query I
WITH sampled AS (
    SELECT l_suppkey, j AS world
    FROM lineitem JOIN orders ON l_orderkey = o_orderkey
    CROSS JOIN range(64) t(j)
    WHERE ((priv_hash(hash(o_custkey)) >> j) & 1::UBIGINT) <> 0
), counts AS (
    SELECT world, l_suppkey, COUNT(*) AS n FROM sampled GROUP BY ALL
), means AS (
    SELECT world, AVG(n) AS mean_count FROM counts GROUP BY world
), decisions AS (
    SELECT s_suppkey, SUM((COALESCE(n, 0) > mean_count)::INTEGER) AS true_worlds
    FROM supplier CROSS JOIN range(64) t(j)
    LEFT JOIN counts ON j = counts.world AND s_suppkey = l_suppkey
    LEFT JOIN means ON j = means.world
    GROUP BY s_suppkey
)
SELECT COUNT(*) FROM decisions WHERE true_worlds >= 32;
----
1

statement ok
SET priv_rewrite = true;

statement ok
SET priv_check = true;

# ============================================================================
# Test 11: Categorical with AVG aggregate
# Find parts where avg quantity exceeds threshold
# All four parts pass in a majority of worlds; both correlated and global
# averages must remain world-specific through the comparison.
# ============================================================================

query I
SELECT count(*) FROM (
    SELECT
        p_partkey
    FROM
        part
    WHERE
        (
            SELECT avg(l_quantity)
            FROM lineitem
            JOIN orders ON l_orderkey = o_orderkey
            WHERE l_partkey = p_partkey
        ) > (
            SELECT 0.8 * avg(l_quantity)
            FROM lineitem
            JOIN orders ON l_orderkey = o_orderkey
        )
);
----
4

# Ordinary SQL oracle: report the number of passing worlds for each part.
statement ok
SET priv_check = false;

statement ok
SET priv_rewrite = false;

query II
WITH sampled AS (
    SELECT l_partkey, l_quantity, j AS world
    FROM lineitem JOIN orders ON l_orderkey = o_orderkey
    CROSS JOIN range(64) t(j)
    WHERE ((priv_hash(hash(o_custkey)) >> j) & 1::UBIGINT) <> 0
), avgs AS (
    SELECT world, l_partkey, AVG(l_quantity) AS a FROM sampled GROUP BY ALL
), means AS (
    SELECT world, AVG(l_quantity) AS m FROM sampled GROUP BY world
)
SELECT p_partkey, SUM((a > 0.8 * m)::INTEGER) AS true_worlds
FROM part CROSS JOIN range(64) t(j)
LEFT JOIN avgs ON j = avgs.world AND p_partkey = l_partkey
LEFT JOIN means ON j = means.world
GROUP BY p_partkey ORDER BY p_partkey;
----
1	41
2	37
3	50
4	50

statement ok
SET priv_rewrite = true;

statement ok
SET priv_check = true;

# ============================================================================
# Test 12: Correlated categorical subquery with multiple tables
# Full Q20-style query with all components
# ============================================================================

query II
SELECT
    s_name,
    s_address
FROM
    supplier
    JOIN nation ON s_nationkey = n_nationkey
WHERE
    s_suppkey IN (
        SELECT
            ps_suppkey
        FROM
            partsupp
            JOIN part ON ps_partkey = p_partkey
        WHERE
            p_name LIKE 'forest%'
            AND ps_availqty > (
                SELECT
                    0.5 * sum(l_quantity)
                FROM
                    lineitem
                    JOIN orders ON l_orderkey = o_orderkey
                WHERE
                    l_partkey = ps_partkey
                    AND l_suppkey = ps_suppkey
                    AND l_shipdate >= DATE '1994-01-01'
                    AND l_shipdate < DATE '1995-01-01'
            )
    )
    AND n_name = 'CANADA'
ORDER BY
    s_name;
----
Supplier#1	Address1
Supplier#2	Address2

# ============================================================================
# Test 13: Categorical with NULL handling 
# The pattern `coalesce((SELECT pac_agg(...)), default_value)` at the filter
# level doesn't work correctly because after PAC transformation, the subquery
# returns LIST<DOUBLE> and coalesce(LIST, scalar) isn't valid.
# For proper NULL handling, use COALESCE inside the subquery instead:
#   SELECT coalesce(sum(...), 0) FROM ...
# ============================================================================

query I
SELECT count(*) FROM (
    SELECT
        ps_partkey
    FROM
        partsupp
    WHERE
        ps_availqty > coalesce((
            SELECT sum(l_quantity)
            FROM lineitem
            JOIN orders ON l_orderkey = o_orderkey
            WHERE l_partkey = ps_partkey
              AND l_suppkey = ps_suppkey
              AND l_shipdate > DATE '2000-01-01'  -- No matching rows
        ), 0)
);
----
6

# ============================================================================
# HAVING with COALESCE over PAC aggregate (crash 30430)
# ============================================================================
# COALESCE(SUM(...), 0) with HAVING SUM(...) > threshold used to crash with a
# NULL shared_ptr dereference in ListVector::GetEntry because the HAVING filter
# was not rewritten when the projection above it triggered categorical conversion.

statement ok
SELECT
    l_partkey,
    COALESCE(SUM(l_quantity), 0) AS total_qty
FROM lineitem
GROUP BY l_partkey
HAVING SUM(l_quantity) > 5;

# Plain SUM ... HAVING (no COALESCE) should also work
statement ok
SELECT
    l_partkey,
    SUM(l_quantity) AS total_qty
FROM lineitem
GROUP BY l_partkey
HAVING SUM(l_quantity) > 10;

# HAVING with ORDER BY — ORDER BY must also handle counter bindings
statement ok
SELECT
    l_partkey,
    COALESCE(SUM(l_quantity), 0) AS total_qty
FROM lineitem
GROUP BY l_partkey
HAVING SUM(l_quantity) > 5
ORDER BY total_qty DESC;

# ============================================================================
# COALESCE(AVG(...)) with ORDER BY/LIMIT (crash 30873)
# ============================================================================
# TopK rewriter wraps LIST colrefs with as_noised() which returns FLOAT,
# but COALESCE was bound for DOUBLE arguments (from AVG). The fix casts
# as_noised() back to the original aggregate type.
# The crash requires COALESCE(AVG(...)) as a direct aggregate in the same
# GROUP BY that feeds into ORDER BY ... LIMIT (TopK pushdown path).

statement ok
WITH CustomerOrders AS (
    SELECT c_custkey, c_name, COUNT(o_orderkey) AS order_count
    FROM customer LEFT JOIN orders ON c_custkey = o_custkey
    WHERE c_acctbal > 1000
    GROUP BY c_custkey, c_name
),
PartSupplierData AS (
    SELECT p_partkey, (ps_supplycost * ps_availqty) AS total_cost
    FROM part LEFT JOIN partsupp ON p_partkey = ps_partkey
    WHERE ps_supplycost IS NOT NULL
),
FinalResult AS (
    SELECT n_nationkey,
           SUM(COALESCE(p.total_cost, 0)) AS total_value,
           COALESCE(AVG(co.order_count), 0) AS avg_orders
    FROM nation
    LEFT JOIN supplier ON n_nationkey = s_nationkey
    LEFT JOIN PartSupplierData p ON s_suppkey = p.p_partkey
    LEFT JOIN CustomerOrders co ON s_suppkey = co.c_custkey
    GROUP BY n_nationkey
)
SELECT n_nationkey, total_value, avg_orders
FROM FinalResult
ORDER BY total_value DESC
LIMIT 10;

# ============================================================================
# Cleanup
# ============================================================================

# ============================================================================
# Mixed DISTINCT + non-DISTINCT with HAVING (crash 25962)
# Multi-branch pre-aggregation creates Projection → Join → Aggregate branches.
# The categorical rewriter must recognize the HAVING predicate through the
# multi-branch projection so it doesn't incorrectly convert aggregates to
# counters (which changes types to LIST<FLOAT> and breaks the projection).
# ============================================================================
statement ok
SELECT s.s_name, p.p_name,
    SUM(ps.ps_availqty) AS total_avail,
    COUNT(DISTINCT c.c_custkey) AS unique_customers,
    AVG(o.o_totalprice) AS avg_price
FROM supplier s
JOIN partsupp ps ON s.s_suppkey = ps.ps_suppkey
JOIN part p ON ps.ps_partkey = p.p_partkey
JOIN lineitem l ON l.l_partkey = p.p_partkey
JOIN orders o ON l.l_orderkey = o.o_orderkey
JOIN customer c ON o.o_custkey = c.c_custkey
GROUP BY s.s_name, p.p_name
HAVING SUM(ps.ps_availqty) > 100
ORDER BY total_avail DESC, avg_price ASC;

# Same pattern with CONCAT referencing both DISTINCT and non-DISTINCT aggregates (crash 27701)
statement ok
SELECT part.p_name, supplier.s_name,
    COUNT(DISTINCT orders.o_orderkey) AS order_count,
    SUM(lineitem.l_extendedprice) AS total_revenue,
    CONCAT('Supplier ', supplier.s_name, ' order count: ', COUNT(DISTINCT orders.o_orderkey)) AS summary
FROM part
JOIN partsupp ON part.p_partkey = partsupp.ps_partkey
JOIN supplier ON partsupp.ps_suppkey = supplier.s_suppkey
JOIN lineitem ON part.p_partkey = lineitem.l_partkey
JOIN orders ON lineitem.l_orderkey = orders.o_orderkey
GROUP BY part.p_name, supplier.s_name
HAVING SUM(lineitem.l_extendedprice) > 10000
ORDER BY total_revenue DESC;

statement ok
DROP TABLE lineitem;

statement ok
DROP TABLE orders;

statement ok
DROP TABLE partsupp;

statement ok
DROP TABLE part;

statement ok
DROP TABLE supplier;

statement ok
DROP TABLE nation;

statement ok
DROP TABLE customer;

# TPC-DS Q09: independent scalar aggregate subqueries in CASE branches.
# Their first()/count_star() cardinality wrappers must expose counter-list types
# without discarding the scalar-subquery cardinality check.
statement ok
CREATE PU TABLE scalar_case_pu (
    id INTEGER, value INTEGER, PRIVACY_KEY(id), PROTECTED(id)
);

statement ok
INSERT INTO scalar_case_pu SELECT i, 10 FROM range(128) t(i);

statement ok
CREATE TABLE scalar_case_reason (id INTEGER);

statement ok
INSERT INTO scalar_case_reason VALUES (1);

query RR
SELECT CASE WHEN (SELECT COUNT(*) FROM scalar_case_pu) > 0
            THEN (SELECT AVG(value) FROM scalar_case_pu)
            ELSE (SELECT AVG(2 * value) FROM scalar_case_pu) END,
       CASE WHEN (SELECT COUNT(*) FROM scalar_case_pu) > 100000
            THEN (SELECT AVG(value) FROM scalar_case_pu)
            ELSE (SELECT AVG(2 * value) FROM scalar_case_pu) END
FROM scalar_case_reason WHERE id = 1;
