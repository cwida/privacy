----
0

statement ok
DROP VIEW domain_nullable_result;

# An input that reads an existing CTE must stay inside that CTE's scope.
statement ok
CREATE VIEW domain_cte_result AS
WITH shared_facts AS MATERIALIZED (SELECT * FROM domain_facts)
SELECT f.supplier, as_count(hash(o.k)) counters
FROM shared_facts f JOIN domain_owners o ON f.k = o.k
WHERE o.keep AND f.late
  AND EXISTS (
      SELECT 1 FROM domain_facts w JOIN domain_owners ow ON w.k = ow.k
      WHERE w.k = f.k AND w.supplier <> f.supplier)
  AND NOT EXISTS (
      SELECT 1 FROM domain_facts w JOIN domain_owners ow ON w.k = ow.k
      WHERE w.k = f.k AND w.supplier <> f.supplier AND w.late)
GROUP BY f.supplier;

query I
SELECT count(*) FROM (
    (SELECT * FROM domain_cte_result EXCEPT ALL SELECT * FROM domain_expected)
    UNION ALL
    (SELECT * FROM domain_expected EXCEPT ALL SELECT * FROM domain_cte_result)
);
