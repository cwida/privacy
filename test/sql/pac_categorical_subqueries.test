    (SELECT * FROM domain_nullable_result EXCEPT ALL SELECT * FROM domain_nullable_expected)
    UNION ALL
    (SELECT * FROM domain_nullable_expected EXCEPT ALL SELECT * FROM domain_nullable_result)
