# Sampling queries must not materialize A x B before joining both keys to C.
# Check duplicate multiplicities and NULL join keys against ordinary execution.
statement ok
SET priv_rewrite=false;

statement ok
CREATE TABLE sample_join_a AS SELECT i%4 id,CASE WHEN i%11=0 THEN NULL ELSE i%7 END k FROM range(100)t(i);

statement ok
CREATE TABLE sample_join_b AS SELECT i%3 id,CASE WHEN i%13=0 THEN NULL ELSE i%5 END k FROM range(80)t(i);

statement ok
CREATE TABLE sample_join_c AS SELECT i%7 ak,i%5 bk,i owner FROM range(32)t(i);

statement ok
CREATE VIEW sample_join_result AS
SELECT a.id aid,b.id bid,c.owner
FROM (sample_join_a a CROSS JOIN sample_join_b b)
JOIN sample_join_c c ON a.k=c.ak AND b.k=c.bk
WHERE (priv_hash(hash(c.owner))&1)<>0;

statement ok
SET disabled_optimizers='extension';

statement ok
CREATE TEMP TABLE sample_join_expected AS SELECT * FROM sample_join_result;

statement ok
SET disabled_optimizers='';

query II
SELECT (SELECT count(*)>0 FROM sample_join_expected),count(*) FROM (
 (SELECT * FROM sample_join_result EXCEPT ALL SELECT * FROM sample_join_expected)
 UNION ALL
 (SELECT * FROM sample_join_expected EXCEPT ALL SELECT * FROM sample_join_result)
);
----
true	0

# Push a filtering relation through either side of an ordinary inner join.
statement ok
CREATE VIEW sample_join_inner AS
SELECT 0 side,a.id aid,b.id bid,c.owner
FROM sample_join_a a JOIN sample_join_b b ON a.id=b.id
JOIN sample_join_c c ON a.k=c.ak WHERE (priv_hash(hash(c.owner))&1)<>0
UNION ALL
SELECT 1 side,a.id aid,b.id bid,c.owner
FROM sample_join_a a JOIN sample_join_b b ON a.id=b.id
JOIN sample_join_c c ON b.k=c.bk WHERE (priv_hash(hash(c.owner))&1)<>0;

statement ok
SET disabled_optimizers='extension';

statement ok
CREATE TEMP TABLE sample_join_inner_expected AS SELECT * FROM sample_join_inner;

statement ok
SET disabled_optimizers='';

query II
SELECT (SELECT count(*)>0 FROM sample_join_inner_expected),count(*) FROM (
 (SELECT * FROM sample_join_inner EXCEPT ALL SELECT * FROM sample_join_inner_expected)
 UNION ALL
 (SELECT * FROM sample_join_inner_expected EXCEPT ALL SELECT * FROM sample_join_inner)
);
----
true	0

