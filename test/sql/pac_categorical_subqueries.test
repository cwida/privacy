# Stored sorted keys cross the core partitioning pass's fixed cardinality and
# row-group thresholds. Compression would otherwise hide the grouping key.
statement ok
SET threads=1;

statement ok
CREATE TABLE partition_input AS
SELECT i::BIGINT k, (i % 7)::INTEGER v FROM range(5000000) r(i);

statement ok
CREATE VIEW partition_result AS
SELECT as_count(hash(k)) counters
FROM (
    SELECT k, SUM(v) total
    FROM partition_input
    GROUP BY k HAVING SUM(v) > 3
) g;

statement ok
SET disabled_optimizers='extension';

statement ok
