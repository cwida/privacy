# Reuse one filtered outer domain across EXISTS/NOT EXISTS ownership lookups.
# Duplicate owners/facts retain their bag multiplicity; orphan facts remain
# excluded by the original ownership joins. Compare every counter with the
# ordinary optimizer, rather than relying on noisy scalar output.
statement ok
CREATE TABLE domain_owners AS
SELECT i::BIGINT k, (i % 2 = 0) keep FROM range(2000) r(i);

statement ok
INSERT INTO domain_owners VALUES (10, true), (10, false), (NULL, true);

statement ok
CREATE TABLE domain_facts AS
SELECT (i % 2000)::BIGINT k, (i // 2000)::INTEGER supplier, (i // 2000 = 0) late
FROM range(10000) r(i);

statement ok
INSERT INTO domain_facts VALUES
    (10, 0, true), (3000, 0, true), (3000, 1, false),
    (NULL, 0, true), (NULL, 1, false), (12, NULL, false);

statement ok
CREATE VIEW domain_result AS
SELECT f.supplier, as_count(hash(o.k)) counters
FROM domain_facts f JOIN domain_owners o ON f.k = o.k
WHERE o.keep AND f.late
  AND EXISTS (
      SELECT 1 FROM domain_facts w JOIN domain_owners ow ON w.k = ow.k
      WHERE w.k = f.k AND w.supplier <> f.supplier)
  AND NOT EXISTS (
      SELECT 1 FROM domain_facts w JOIN domain_owners ow ON w.k = ow.k
      WHERE w.k = f.k AND w.supplier <> f.supplier AND w.late)
GROUP BY f.supplier;

statement ok
SET disabled_optimizers='extension';

statement ok
CREATE TEMP TABLE domain_expected AS SELECT * FROM domain_result;

statement ok
SET disabled_optimizers='';

query I
SELECT count(*) FROM (
    (SELECT * FROM domain_result EXCEPT ALL SELECT * FROM domain_expected)
    UNION ALL
    (SELECT * FROM domain_expected EXCEPT ALL SELECT * FROM domain_result)
);
----
0

statement ok
SET threads=4;

query I
SELECT count(*) FROM (
    (SELECT * FROM domain_result EXCEPT ALL SELECT * FROM domain_expected)
    UNION ALL
    (SELECT * FROM domain_expected EXCEPT ALL SELECT * FROM domain_result)
);
----
0

# Null-safe membership predicates do not make NULL ownership keys joinable.
statement ok
CREATE VIEW domain_nullable_result AS
SELECT f.supplier, as_count(hash(o.k)) counters
FROM domain_facts f JOIN domain_owners o ON f.k = o.k
WHERE o.keep AND f.late
  AND EXISTS (
      SELECT 1 FROM domain_facts w JOIN domain_owners ow ON w.k = ow.k
      WHERE w.k IS NOT DISTINCT FROM f.k AND w.supplier IS DISTINCT FROM f.supplier)
  AND NOT EXISTS (
      SELECT 1 FROM domain_facts w JOIN domain_owners ow ON w.k = ow.k
      WHERE w.k IS NOT DISTINCT FROM f.k AND w.supplier IS DISTINCT FROM f.supplier AND w.late)
GROUP BY f.supplier;

statement ok
SET disabled_optimizers='extension';

statement ok
CREATE TEMP TABLE domain_nullable_expected AS SELECT * FROM domain_nullable_result;

statement ok
