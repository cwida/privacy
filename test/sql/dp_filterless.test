# name: test/sql/dp_filterless.test
# description: Filter-independent contribution-bound estimation for SUM, COUNT, and AVG
# group: [sql]

require privacy

statement ok
PRAGMA clear_privacy_metadata;

statement ok
SET threads = 1;

statement ok
SET privacy_seed = 42;

statement ok
SET privacy_mode = 'dp_filterless';

query I
SELECT current_setting('privacy_mode');
----
dp_filterless

statement ok
SET dp_epsilon = 100.0;

statement ok
SET dp_filterless_clip_support = 2.0;

statement ok
SET dp_filterless_sample_bits = 0;

statement ok
SET privacy_noise = false;

# The aggregate functions remain directly callable for debugging. The filtered
# answer and unfiltered histogram values are separate arguments. With p=0,
# every PU enters the histogram, but only active values enter the answer.
query RRRII
SELECT x.upper_bound, x.clipped_value, x.positive_support,
       x.active_contributions, x.sampled_contributions
FROM (
    SELECT filterless_sum_debug(pu, active, answer_value, histogram_value) AS x
    FROM (VALUES
        (0::UBIGINT, true, 50.0::DOUBLE, 50.0::DOUBLE),
        (2::UBIGINT, true, 50.0::DOUBLE, 50.0::DOUBLE),
        (4::UBIGINT, false, 0.0::DOUBLE, 1000.0::DOUBLE)
    ) input(pu, active, answer_value, histogram_value)
);
----
128.000000	100.000000	2.000000	2	3

# Making the outlier active changes the answer, but not the selected bound.
# The outlier is clipped to 128 rather than omitted.
query RR
SELECT x.upper_bound, x.clipped_value
FROM (
    SELECT filterless_sum_debug(pu, active, answer_value, histogram_value) AS x
    FROM (VALUES
        (0::UBIGINT, true, 50.0::DOUBLE, 50.0::DOUBLE),
        (2::UBIGINT, true, 50.0::DOUBLE, 50.0::DOUBLE),
        (4::UBIGINT, true, 1000.0::DOUBLE, 1000.0::DOUBLE)
    ) input(pu, active, answer_value, histogram_value)
);
----
128.000000	228.000000

query RRR
SELECT x.released_average, x.clipped_sum, x.clipped_count
FROM (
    SELECT filterless_avg_debug(pu, active, answer_sum, answer_count, histogram_sum, histogram_count) AS x
    FROM (VALUES
        (0::UBIGINT, true, 50.0::DOUBLE, 2.0::DOUBLE, 50.0::DOUBLE, 2.0::DOUBLE),
        (2::UBIGINT, true, 50.0::DOUBLE, 2.0::DOUBLE, 50.0::DOUBLE, 2.0::DOUBLE)
    ) input(pu, active, answer_sum, answer_count, histogram_sum, histogram_count)
);
----
25.000000	100.000000	4.000000

# Sampling is deterministic from the high PU bits. At p=6, PU 0 is sampled and
# receives weight 64; PUs with the high bit set are not sampled. Qualifying
# non-sampled PUs enter the answer but not the histogram.
statement ok
SET dp_filterless_sample_bits = 6;

query RII
SELECT x.positive_support, x.active_contributions, x.sampled_contributions
FROM (
    SELECT filterless_sum_debug(pu, active, answer_value, histogram_value) AS x
    FROM (VALUES
        (9223372036854775808::UBIGINT, true, 50.0::DOUBLE, 50.0::DOUBLE),
        (0::UBIGINT, false, 0.0::DOUBLE, 1000.0::DOUBLE),
        (9223372036854775810::UBIGINT, false, 0.0::DOUBLE, 1000.0::DOUBLE)
    ) input(pu, active, answer_value, histogram_value)
);
----
64.000000	1	1

# An unsampled qualifying PU changes the answer but not the histogram. Both
# worlds therefore select the same bound from the two fixed sampled PUs.
statement ok
SET dp_filterless_clip_support = 128.0;

query IRR
SELECT world, x.upper_bound, x.clipped_value
FROM (
    SELECT world, filterless_sum_debug(pu, active, answer_value, histogram_value) AS x
    FROM (VALUES
        (0, 0::UBIGINT, true, 50.0::DOUBLE, 50.0::DOUBLE),
        (0, 2::UBIGINT, true, 50.0::DOUBLE, 50.0::DOUBLE),
        (0, 9223372036854775808::UBIGINT, false, 0.0::DOUBLE, 1000.0::DOUBLE),
        (1, 0::UBIGINT, true, 50.0::DOUBLE, 50.0::DOUBLE),
        (1, 2::UBIGINT, true, 50.0::DOUBLE, 50.0::DOUBLE),
        (1, 9223372036854775808::UBIGINT, true, 1000.0::DOUBLE, 1000.0::DOUBLE)
    ) input(world, pu, active, answer_value, histogram_value)
    GROUP BY world
) worlds
ORDER BY world;
----
0	128.000000	100.000000
1	128.000000	228.000000

# Explicit nonces are group identities supplied by the compiler. Accepting two
# values in one aggregate group would make the release depend on row order.
statement error
SELECT filterless_sum(pu, true, contribution, contribution, 1.0, 1.0, nonce)
FROM (VALUES
    (1::UBIGINT, 50.0::DOUBLE, 1::UBIGINT),
    (3::UBIGINT, 50.0::DOUBLE, 2::UBIGINT)
) input(pu, contribution, nonce);
----
filterless: noise nonce must be constant within each aggregate group

statement ok
SET dp_filterless_sample_bits = 0;

statement ok
SET dp_filterless_clip_support = 2.0;

# Exercise parallel aggregate combine, including the explicit nonce invariant.
statement ok
SET threads = 4;

query R
SELECT filterless_sum((i::UBIGINT << 1), true, 50.0, 50.0, 100.0, 1.0, 7::UBIGINT)
FROM range(100000) t(i);
----
5000000.000000

statement ok
SET threads = 1;

# End-to-end compiler path on a PU table. Two ordinary PUs establish the
# clipping bound. The billionaire contribution is included in the histogram
# even when the predicate excludes it.
statement ok
CREATE PU TABLE filterless_people (
    uid BIGINT,
    segment VARCHAR,
    salary DOUBLE,
    PRIVACY_KEY (uid),
    PROTECTED (salary)
);

statement ok
INSERT INTO filterless_people VALUES
    (1, 'ordinary', 50.0),
    (2, 'ordinary', 50.0),
    (3, 'billionaire', 1000.0);

query RIR
SELECT SUM(salary), COUNT(*), AVG(salary)
FROM filterless_people
WHERE salary < 100.0;
----
100.000000	2	50.000000

query RIR
SELECT SUM(salary), COUNT(*), AVG(salary)
FROM filterless_people;
----
228.000000	3	76.000000

# Equivalent populations reached through different predicates use different
# query nonces. Otherwise sticky noise would cancel across a filter attack.
statement ok
SET dp_epsilon = 1.0;

statement ok
SET privacy_noise = true;

statement ok
CREATE TEMP TABLE filterless_noise_a AS
SELECT SUM(salary) AS result FROM filterless_people WHERE salary < 2000.0;

statement ok
CREATE TEMP TABLE filterless_noise_b AS
SELECT SUM(salary) AS result FROM filterless_people WHERE salary <= 1000.0;

query I
SELECT a.result <> b.result FROM filterless_noise_a a, filterless_noise_b b;
----
true

statement ok
SET privacy_noise = false;

statement ok
SET dp_epsilon = 100.0;

# A NULL predicate result is non-qualifying, but p=0 still includes that PU's
# complete unfiltered contribution in the histogram. The two NULL-predicate
# outliers therefore support the outlier bin.
statement ok
CREATE PU TABLE filterless_null_predicate (
    uid BIGINT,
    qualifies BOOLEAN,
    amount DOUBLE,
    PRIVACY_KEY (uid),
    PROTECTED (amount)
);

statement ok
INSERT INTO filterless_null_predicate VALUES
    (1, true, 50.0),
    (2, true, 50.0),
    (3, true, 1000.0),
    (4, NULL, 1000.0),
    (5, NULL, 1000.0);

query R
SELECT SUM(amount)
FROM filterless_null_predicate
WHERE qualifies;
----
1100.000000

# A high support threshold proves that the SQL query is actually rewritten,
# even with privacy_noise=false: no bin is supported, so the clipped result is 0.
statement ok
SET dp_filterless_clip_support = 100.0;

query RI
SELECT SUM(salary), COUNT(*)
FROM filterless_people;
----
0.000000	0

statement ok
SET dp_filterless_clip_support = 2.0;

# Grouped queries use private partition selection. Sampled inactive rows can
# shape clipping bounds but cannot make an absent filtered group appear.
statement ok
SET dp_delta = 0.49;

statement ok
SET dp_max_groups_contributed = 1;

statement ok
CREATE PU TABLE filterless_groups (
    uid BIGINT,
    grp VARCHAR,
    amount DOUBLE,
    PRIVACY_KEY (uid),
    PROTECTED (amount)
);

statement ok
INSERT INTO filterless_groups VALUES
    (1, 'a', 50.0),
    (2, 'a', 50.0),
    (3, 'b', 1000.0),
    (4, 'b', 1000.0);

query IR
SELECT grp, SUM(amount)
FROM filterless_groups
WHERE amount < 100.0
GROUP BY grp
ORDER BY grp;
----
a	100.000000

# The existing Google-style L0 rule is retained: the lower aggregate emits one
# row per logical PU/group, and hash-ranked row selection keeps at most C_u
# groups. Which bounded group survives is not part of the query contract.
statement ok
CREATE PU TABLE filterless_group_cap (
    uid BIGINT,
    grp VARCHAR,
    amount DOUBLE,
    PRIVACY_KEY (uid),
    PROTECTED (amount)
);

statement ok
INSERT INTO filterless_group_cap VALUES
    (1, 'a', 50.0), (1, 'b', 50.0),
    (2, 'a', 50.0), (2, 'b', 50.0);

query R
SELECT SUM(amount)
FROM filterless_group_cap
GROUP BY grp
ORDER BY grp;
----
100.000000

statement ok
SET dp_max_groups_contributed = 2;

query IR
SELECT grp, SUM(amount)
FROM filterless_group_cap
GROUP BY grp
ORDER BY grp;
----
a	100.000000
b	100.000000

# Exercise a genuine top-k cap with more candidate groups than C_u. The private
# query must retain exactly three contributions per PU across its released rows.
statement ok
SET dp_max_groups_contributed = 3;

statement ok
CREATE PU TABLE filterless_group_cap_three (
    uid BIGINT,
    grp BIGINT,
    amount DOUBLE,
    PRIVACY_KEY (uid),
    PROTECTED (amount)
);

statement ok
INSERT INTO filterless_group_cap_three
SELECT uid, grp, 1.0
FROM range(100) users(uid), range(10) groups(grp);

statement ok
CREATE TEMP TABLE filterless_group_cap_three_result AS
SELECT grp, SUM(amount) AS total
FROM filterless_group_cap_three
GROUP BY grp;

query IR
SELECT COUNT(*), SUM(total)
FROM filterless_group_cap_three_result;
----
10	300.000000

# DuckDB should optimize ROW_NUMBER <= 3 into a bounded per-PU top-k aggregate
# plus UNNEST, instead of sorting a window.
statement ok
SET explain_output = 'physical_only';

query II
EXPLAIN SELECT grp, SUM(amount)
FROM filterless_group_cap_three
GROUP BY grp;
----
physical_plan	<REGEX>:[\s\S]*UNNEST[\s\S]*arg_min_nulls_last[\s\S]*

statement ok
SET dp_max_groups_contributed = 1;

# Reuse the FK-linked PU machinery. Clipping applies after rows are summed into
# one contribution per logical PU.
statement ok
CREATE PU TABLE filterless_customers (
    uid BIGINT,
    PRIVACY_KEY (uid)
);

statement ok
INSERT INTO filterless_customers VALUES (1), (2), (3);

statement ok
CREATE TABLE filterless_orders (
    uid BIGINT,
    amount DOUBLE,
    PRIVACY_LINK (uid) REFERENCES filterless_customers(uid)
);

statement ok
INSERT INTO filterless_orders VALUES
    (1, 20.0), (1, 30.0),
    (2, 20.0), (2, 30.0),
    (3, 1000.0);

query RIR
SELECT SUM(amount), COUNT(*), AVG(amount)
FROM filterless_orders
WHERE amount < 100.0;
----
100.000000	4	25.000000

# Floating SUM and AVG numerators use the AS magnitude accumulator both in the
# per-PU pre-aggregation and in the final filterless aggregate. The two PUs use
# opposite row orders; ordinary DOUBLE SUM loses the 1.0 in both cases, while
# the two-sided approximate accumulator preserves it. COUNT remains exact.
statement ok
CREATE TABLE filterless_approx_values (
    uid BIGINT,
    amount DOUBLE,
    PRIVACY_LINK (uid) REFERENCES filterless_customers(uid)
);

statement ok
INSERT INTO filterless_approx_values VALUES
    (1, 1e16), (1, 1.0), (1, -1e16),
    (2, -1e16), (2, 1.0), (2, 1e16);

query RIR
SELECT SUM(amount), COUNT(*), AVG(amount)
FROM filterless_approx_values;
----
2.000000	6	0.333333

# The top floating bin has a finite advertised clipping bound. Contributions
# beyond the fixed-point AS range are symmetrically saturated and cannot pass
# through that top bin above its bound.
query RR
SELECT x.upper_bound, x.clipped_value
FROM (
    SELECT filterless_sum_debug(pu, true, amount, amount) AS x
    FROM (VALUES
        (0::UBIGINT, 1e20::DOUBLE),
        (2::UBIGINT, 1e20::DOUBLE)
    ) input(pu, amount)
);
----
8589934592.000000	17179869184.000000

# Fine grouping: 30 and 40 fall into adjacent exponential bins. With support 2,
# neither bin selects a SUM bound even though two PUs qualify.
statement ok
CREATE TABLE filterless_fine_bins (
    uid BIGINT,
    amount DOUBLE,
    PRIVACY_LINK (uid) REFERENCES filterless_customers(uid)
);

statement ok
INSERT INTO filterless_fine_bins VALUES
    (1, 10.0), (1, 20.0),
    (2, 10.0), (2, 30.0),
    (3, 1000.0);

query R
SELECT SUM(amount)
FROM filterless_fine_bins
WHERE amount < 100.0;
----
0.000000

# UIDs 0 and 89 both belong to the fixed 1/64 hash sample. Each sampled PU is
# pre-aggregated once for the histogram across all its rows, while the answer
# partial follows the predicate. Changing the filter therefore changes SUM and
# AVG but leaves the unfiltered 6000-per-PU histogram unchanged.
statement ok
SET dp_filterless_sample_bits = 6;

statement ok
SET dp_filterless_clip_support = 128.0;

statement ok
CREATE PU TABLE filterless_sampled_customers (
    uid BIGINT,
    PRIVACY_KEY (uid)
);

statement ok
INSERT INTO filterless_sampled_customers VALUES (0), (89);

statement ok
CREATE TABLE filterless_sampled_events (
    uid BIGINT,
    qualifies BOOLEAN,
    amount DOUBLE,
    PRIVACY_LINK (uid) REFERENCES filterless_sampled_customers(uid)
);

statement ok
INSERT INTO filterless_sampled_events VALUES
    (0, true, 5000.0), (0, false, 1000.0),
    (89, true, 5000.0), (89, false, 1000.0);

query RIR
SELECT SUM(amount), COUNT(*), AVG(amount)
FROM filterless_sampled_events
WHERE qualifies;
----
10000.000000	2	5000.000000

query RIR
SELECT SUM(amount), COUNT(*), AVG(amount)
FROM filterless_sampled_events
WHERE NOT qualifies;
----
2000.000000	2	1000.000000

statement ok
SET dp_filterless_sample_bits = 0;

statement ok
SET dp_filterless_clip_support = 2.0;

# Bounds are mandatory; the prototype does not silently invent a public default.
statement ok
SET dp_filterless_clip_support = NULL;

statement error
SELECT SUM(salary) FROM filterless_people;
----
dp_filterless_clip_support must be set to a positive finite number

statement ok
SET dp_filterless_clip_support = 2.0;

# Aggregate-local FILTER has different semantics from widening WHERE and is
# rejected until it has a dedicated rewrite.
statement error
SELECT SUM(salary) FILTER (WHERE salary < 100.0) FROM filterless_people;
----
dp_filterless: aggregate FILTER clauses are not implemented yet

# Integer and DECIMAL partials stay exact through the filterless aggregate. In
# particular, values above DOUBLE's 53-bit integer range must not be rounded.
statement ok
SET privacy_noise = false;

statement ok
SET dp_filterless_clip_support = 1.0;

statement ok
CREATE PU TABLE filterless_exact_numeric (
    uid BIGINT,
    integer_amount BIGINT,
    decimal_amount DECIMAL(38, 2),
    PRIVACY_KEY (uid),
    PROTECTED (integer_amount),
    PROTECTED (decimal_amount)
);

statement ok
INSERT INTO filterless_exact_numeric VALUES
    (1, 9007199254740993, 90071992547409.93),
    (2, 2, 0.02);

query IRTT
SELECT SUM(integer_amount), SUM(decimal_amount),
       typeof(SUM(integer_amount)), typeof(SUM(decimal_amount))
FROM filterless_exact_numeric;
----
9007199254740995	90071992547409.95	HUGEINT	DECIMAL(38,2)

# The public SQL aggregate overload uses the same exact state as the compiler.
query RT
SELECT filterless_sum(pu, true, answer_value, histogram_value),
       typeof(filterless_sum(pu, true, answer_value, histogram_value))
FROM (VALUES
    (0::UBIGINT, 90071992547409.93::DECIMAL(38, 2), 90071992547409.93::DECIMAL(38, 2)),
    (2::UBIGINT, 0.02::DECIMAL(38, 2), 0.02::DECIMAL(38, 2))
) input(pu, answer_value, histogram_value);
----
90071992547409.95	DECIMAL(38,2)

# Exact DP aggregates use saturating post-processing at the public SQL return
# type boundary. They never turn an oversized value or noise draw into an
# observable query error.
query I
SELECT filterless_count(pu, true, answer_value, histogram_value)
FROM (VALUES
    (0::UBIGINT, 9223372036854775807::BIGINT, 9223372036854775807::BIGINT),
    (2::UBIGINT, 9223372036854775807::BIGINT, 9223372036854775807::BIGINT)
) input(pu, answer_value, histogram_value);
----
9223372036854775807

# Exact states also merge without converting their bin sums to DOUBLE.
statement ok
SET threads = 4;

query R
SELECT filterless_sum((i::UBIGINT << 1), true,
                      9007199254740993::DECIMAL(38, 0),
                      9007199254740993::DECIMAL(38, 0))
FROM range(10000) t(i);
----
90071992547409930000

statement ok
SET threads = 1;

# Exercise private bound selection with the exact numeric state and the batched
# histogram-noise generator. The numeric result is intentionally not fixed.
statement ok
SET privacy_noise = true;

query I
SELECT isfinite(SUM(decimal_amount)::DOUBLE)
FROM filterless_exact_numeric;
----
true

# Even an extreme public epsilon cannot turn a large private bound/noise draw
# into an observable overflow error. Results saturate at their SQL type limits.
statement ok
SET dp_epsilon = 1e-300;

query III
SELECT SUM(integer_amount) IS NOT NULL,
       COUNT(*) IS NOT NULL,
       SUM(decimal_amount) BETWEEN
           -999999999999999999999999999999999999.99::DECIMAL(38, 2) AND
            999999999999999999999999999999999999.99::DECIMAL(38, 2)
FROM filterless_exact_numeric;
----
true	true	true

statement ok
SET dp_epsilon = 100.0;

statement ok
SET privacy_noise = false;

statement ok
PRAGMA clear_privacy_metadata;
