# =============================================================================
# GROUP BY tests
# =============================================================================

# Test as_max with GROUP BY (mi=0 returns actual values, not NULL)
query II rowsort
SELECT i % 3 as grp, as_noised_max(priv_hash(hash('key' || i::varchar)), i::integer)
FROM range(1, 100) t(i)
GROUP BY grp;
----
0	96
1	97
2	92

# Test as_min with GROUP BY (mi=0 returns actual values, not NULL)
query II rowsort
SELECT i % 3 as grp, as_noised_min(priv_hash(hash('key' || i::varchar)), i::integer)
FROM range(1, 100) t(i)
GROUP BY grp;
----
0	6
1	4
2	11

# =============================================================================
# Edge cases
# =============================================================================

# Test with single value (mi=0 returns actual value)
query I
SELECT as_noised_max(1::UBIGINT, 42::integer);
----
42

query I
SELECT as_noised_min(1::UBIGINT, 42::integer);
----
42

# Test with large values (BIGINT)
query I
SELECT as_noised_max(priv_hash(hash('key' || i::varchar)), (i * 1000000000)::bigint) FROM range(1, 100) t(i);
----
96999997440

query I
SELECT as_noised_min(priv_hash(hash('key' || i::varchar)), (i * 1000000000)::bigint) FROM range(1, 100) t(i);
----
4000000000

# Test with small range
query I
SELECT as_noised_max(priv_hash(hash('key' || i::varchar)), i::integer) FROM range(1, 10) t(i);
----
9

# Test with scaled values
query I
SELECT as_noised_max(priv_hash(hash('key' || i::varchar)), (i * 100)::integer) FROM range(1, 10) t(i);
----
900

# Test with larger scaled values
query I
SELECT as_noised_max(priv_hash(hash('key' || i::varchar)), (i * 100000)::integer) FROM range(1, 10) t(i);
----
900000

# Test float with scaling
query R
SELECT round(as_noised_max(priv_hash(hash('key' || i::varchar)), (i * 100.0)::double), 1) FROM range(1, 100) t(i);
----
9700.0

query R
SELECT round(as_noised_min(priv_hash(hash('key' || i::varchar)), (i * 100.0)::double), 1) FROM range(1, 100) t(i);
----
400.0

# Test double with large values
query R
SELECT round(as_noised_max(priv_hash(hash('key' || i::varchar)), (i * 2000000.0)::double), 0) FROM range(1, 100) t(i);
----
194000000.0

query R
SELECT round(as_noised_min(priv_hash(hash('key' || i::varchar)), (i * 2000000.0)::double), 0) FROM range(1, 100) t(i);
----
8000000.0

