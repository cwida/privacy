# name: test/sql/pac_min_max.test
# description: Test as_min and as_max aggregate functions
# group: [sql]

require privacy

statement ok
PRAGMA clear_privacy_metadata;

# Set deterministic seed for cross-CPU reproducibility
statement ok
SET privacy_seed = 42

statement ok
SET pac_hash_repair = true

statement ok
SET threads = 1

statement ok
SET pac_mi = 0

# =============================================================================
# as_max tests
# =============================================================================

# Test as_max with TINYINT (INT8)
query I
SELECT as_noised_max(priv_hash(hash('key' || i::varchar)), i::tinyint) FROM range(1, 50) t(i);
----
48

# Test as_max with SMALLINT (INT16)
query I
SELECT as_noised_max(priv_hash(hash('key' || i::varchar)), i::smallint) FROM range(1, 100) t(i);
----
97

# Test as_max with INTEGER (INT32)
query I
SELECT as_noised_max(priv_hash(hash('key' || i::varchar)), i::integer) FROM range(1, 100) t(i);
----
97

# Test as_max with BIGINT (INT64)
query I
SELECT as_noised_max(priv_hash(hash('key' || i::varchar)), i::bigint) FROM range(1, 100) t(i);
----
97

# Test as_max with UTINYINT (UINT8)
query I
SELECT as_noised_max(priv_hash(hash('key' || i::varchar)), i::utinyint) FROM range(1, 50) t(i);
----
48

# Test as_max with USMALLINT (UINT16)
query I
SELECT as_noised_max(priv_hash(hash('key' || i::varchar)), i::usmallint) FROM range(1, 100) t(i);
----
97

# Test as_max with UINTEGER (UINT32)
query I
SELECT as_noised_max(priv_hash(hash('key' || i::varchar)), i::uinteger) FROM range(1, 100) t(i);
----
97

# Test as_max with UBIGINT (UINT64)
query I
SELECT as_noised_max(priv_hash(hash('key' || i::varchar)), i::ubigint) FROM range(1, 100) t(i);
----
97

# Test as_max with FLOAT
query R
SELECT round(as_noised_max(priv_hash(hash('key' || i::varchar)), i::float), 1) FROM range(1, 100) t(i);
----
97.0

# Test as_max with DOUBLE
query R
SELECT round(as_noised_max(priv_hash(hash('key' || i::varchar)), i::double), 1) FROM range(1, 100) t(i);
----
97.0

# Test as_max with negative values (signed types)
query I
SELECT as_noised_max(priv_hash(hash('key' || i::varchar)), i::integer) FROM range(-50, 50) t(i);
----
48

# Test as_max with non-zero mi parameter (deterministic results due to privacy_seed)
statement ok
SET pac_mi = 128

query I
SELECT as_noised_max(priv_hash(hash('key' || i::varchar)), i::integer) IS NOT NULL FROM range(1, 100) t(i);
----
true

statement ok
SET pac_mi = 0

# Test as_max with mi parameter (0.0 for no noise)
query I
SELECT as_noised_max(priv_hash(hash('key' || i::varchar)), i::integer) FROM range(1, 100) t(i);
----
97

