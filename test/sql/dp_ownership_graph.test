statement ok
ALTER TABLE og_nonunique_fact ADD PRIVACY_KEY(id);

statement ok
ALTER TABLE og_nonunique_fact ADD PRIVACY_LINK(parent_code) REFERENCES og_nonunique_parent(code);

statement error
SELECT * FROM privacy_ownership_bounds_debug('og_nonunique_fact');
